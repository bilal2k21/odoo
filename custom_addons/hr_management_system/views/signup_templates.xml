<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         CREATE ACCOUNT  (URL: /signup)
    ============================================================= -->
    <template id="signup_page" name="Create Account">
        <t t-call="hr_management_system.portal_layout">
            <t t-set="page_title">Create your account · Metaviz HR Suite</t>

            <div class="auth">
                <div class="auth__card">

                    <!-- ============ LEFT PANEL ============ -->
                    <aside class="auth__left">
                        <div class="brand">
                            <svg class="brand__logo" viewBox="0 0 40 36" xmlns="http://www.w3.org/2000/svg">
                                <defs>
                                    <linearGradient id="mvLogo" x1="0" y1="0" x2="1" y2="1">
                                        <stop offset="0" stop-color="#ffc24b"/>
                                        <stop offset="1" stop-color="#f0881c"/>
                                    </linearGradient>
                                </defs>
                                <path d="M5 5 L20 31 L35 5" fill="none" stroke="url(#mvLogo)" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M20 6 L20 17" fill="none" stroke="url(#mvLogo)" stroke-width="7.5" stroke-linecap="round"/>
                            </svg>
                            <span class="brand__name">METAVIZ</span>
                            <span class="brand__suite">HR Suite</span>
                        </div>

                        <div class="left__content">
                            <span class="badge">
                                <span class="badge__dot"></span>Free 30-day trial
                            </span>

                            <h1 class="hero">Set up your team in<br/><span class="hero__accent">minutes, not weeks.</span></h1>

                            <p class="hero__sub">Create your Metaviz workspace and bring onboarding, attendance, payroll and people data into one calm place.</p>

                            <ul class="features">
                                <li>
                                    <svg class="check" width="18" height="18" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M4 10.5 L8.5 15 L16 5.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    No credit card required to start
                                </li>
                                <li>
                                    <svg class="check" width="18" height="18" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M4 10.5 L8.5 15 L16 5.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    Invite your whole team for free
                                </li>
                                <li>
                                    <svg class="check" width="18" height="18" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M4 10.5 L8.5 15 L16 5.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    Enterprise-grade security &amp; SSO
                                </li>
                            </ul>
                        </div>

                        <div class="left__footer">
                            <span>© 2026 Metaviz Technologies</span>
                            <nav class="left__links">
                                <a href="#">Privacy</a>
                                <a href="#">Terms</a>
                                <a href="#">Status</a>
                            </nav>
                        </div>
                    </aside>

                    <!-- ============ RIGHT PANEL ============ -->
                    <section class="auth__right">
                        <div class="signin-top">Already have an account? <a href="/login">Sign in</a></div>

                        <div class="form-wrap">
                            <h2 class="form__title">Create your account</h2>
                            <p class="form__sub">Start your free Metaviz HR workspace today.</p>

                            <!-- Social -->
                            <div class="social">
                                <button type="button" class="social__btn">
                                    <svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path fill="#4285f4" d="M23.52 12.27c0-.79-.07-1.54-.2-2.27H12v4.51h6.47a5.53 5.53 0 0 1-2.4 3.63v3h3.88c2.27-2.09 3.57-5.17 3.57-8.87z"/>
                                        <path fill="#34a853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3c-1.08.72-2.45 1.16-4.05 1.16-3.11 0-5.75-2.1-6.69-4.93H1.3v3.1A12 12 0 0 0 12 24z"/>
                                        <path fill="#fbbc05" d="M5.31 14.32a7.2 7.2 0 0 1 0-4.63V6.59H1.3a12 12 0 0 0 0 10.83l4.01-3.1z"/>
                                        <path fill="#ea4335" d="M12 4.75c1.76 0 3.34.61 4.58 1.8l3.43-3.43C17.95 1.17 15.24 0 12 0A12 12 0 0 0 1.3 6.59l4.01 3.1C6.25 6.85 8.89 4.75 12 4.75z"/>
                                    </svg>
                                    Google
                                </button>
                                <button type="button" class="social__btn">
                                    <svg width="16" height="16" viewBox="0 0 23 23" xmlns="http://www.w3.org/2000/svg">
                                        <path fill="#f25022" d="M1 1h10v10H1z"/>
                                        <path fill="#7fba00" d="M12 1h10v10H12z"/>
                                        <path fill="#00a4ef" d="M1 12h10v10H1z"/>
                                        <path fill="#ffb900" d="M12 12h10v10H12z"/>
                                    </svg>
                                    Microsoft
                                </button>
                            </div>

                            <div class="divider"><span>Or sign up with email</span></div>

                            <!-- Form -->
                            <form class="form" method="post" action="/dummy-login">
                                <div class="row">
                                    <div class="field">
                                        <label>First name</label>
                                        <input type="text" name="first_name" placeholder="Samira"/>
                                    </div>
                                    <div class="field">
                                        <label>Last name</label>
                                        <input type="text" name="last_name" placeholder="Reyes"/>
                                    </div>
                                </div>

                                <div class="field">
                                    <label>Company / workspace name</label>
                                    <div class="input-icon has-icon">
                                        <svg class="field-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M3 21h18"/><path d="M5 21V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v16"/><path d="M15 21V9h3a1 1 0 0 1 1 1v11"/><path d="M8 7h2M8 11h2M8 15h2"/>
                                        </svg>
                                        <input type="text" name="company" placeholder="Acme Inc."/>
                                    </div>
                                </div>

                                <div class="field">
                                    <label>Work email</label>
                                    <div class="input-icon has-icon">
                                        <svg class="field-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                                            <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
                                        </svg>
                                        <input type="email" name="email" placeholder="you@company.com"/>
                                    </div>
                                </div>

                                <div class="field">
                                    <label>Password</label>
                                    <div class="input-icon has-icon">
                                        <svg class="field-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                                            <rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
                                        </svg>
                                        <input type="password" id="hrms-password" name="password" placeholder="Create a password"/>
                                        <button type="button" class="eye" data-toggle-pwd="1" aria-label="Show password">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>
                                            </svg>
                                        </button>
                                    </div>
                                    <div class="pwd-strength"><span></span></div>
                                </div>

                                <label class="agree">
                                    <input type="checkbox" name="agree"/>
                                    <span>I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.</span>
                                </label>

                                <button type="submit" class="btn-primary">
                                    Create account
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
                                    </svg>
                                </button>

                                <p class="form__fine">By continuing you agree to receive product updates. Unsubscribe anytime.</p>
                            </form>
                        </div>
                    </section>

                </div>
            </div>
        </t>
    </template>

</odoo>
