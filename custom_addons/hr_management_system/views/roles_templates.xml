<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         SETTINGS → ROLES & PERMISSIONS  (/settings/roles)
    ============================================================= -->
    <template id="roles_page" name="Roles &amp; Permissions">
        <t t-set="active" t-value="'settings'"/>
        <t t-set="section" t-value="'Settings'"/>
        <t t-set="subnav" t-value="'roles'"/>
        <t t-set="topbar_action" t-value="'Create New Role'"/>
        <t t-set="page_name" t-value="'Roles &amp; Permissions'"/>
        <t t-call="hr_management_system.dashboard_layout">

            <div class="rp-head">
                <div>
                    <h1 class="set-head__title">Roles &amp; Permissions</h1>
                    <p class="set-head__sub">Manage roles and their access permissions across the organization</p>
                </div>
            </div>

            <!-- Stat cards -->
            <div class="rp-stats">
                <div class="rp-stat">
                    <div class="rp-stat__label">Total Roles</div>
                    <div class="rp-stat__row">
                        <span class="rp-stat__ic rp-stat__ic--blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5"/></svg></span>
                        <span class="rp-stat__num">7</span>
                    </div>
                </div> 
                <div class="rp-stat">
                    <div class="rp-stat__label">Assigned Users</div>
                    <div class="rp-stat__row">
                        <span class="rp-stat__ic rp-stat__ic--green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="9" cy="8" r="3.2"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 5.2a3.2 3.2 0 0 1 0 6.1M21.5 20a6 6 0 0 0-4.5-5.8"/></svg></span>
                        <span class="rp-stat__num">49</span>
                    </div>
                </div> 
                <div class="rp-stat">
                    <div class="rp-stat__label">Permissions</div>
                    <div class="rp-stat__row">
                        <span class="rp-stat__ic rp-stat__ic--orange"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="m8 12 3 3 5-6"/></svg></span>
                        <span class="rp-stat__num">38</span>
                    </div> 
                </div> 
                <div class="rp-stat">
                    <div class="rp-stat__label">Templates</div>
                    <div class="rp-stat__row">
                        <span class="rp-stat__ic rp-stat__ic--purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg></span>
                        <span class="rp-stat__num">5</span>
                    </div>
                </div>
            </div>

            <!-- Quick Start Templates -->
            <div class="rp-tpl-card">
                <div class="rp-tpl-head">
                    <h2 class="rp-tpl-head__title">Quick Start Templates</h2>
                    <p class="rp-tpl-head__sub">Choose a template to pre-fill a new role</p>
                </div>
                <div class="rp-tpls">
                    <div class="rp-tpl">
                        <span class="rp-tpl__ic rp-tpl__ic--green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M9 13h6M9 17h4"/></svg></span>
                        <div class="rp-tpl__name">HR Template</div>
                        <div class="rp-tpl__desc">HR related permissions</div>
                        <button class="rp-tpl__btn" type="button" data-tpl-open="1" data-tpl-name="HR Template">Use Template</button>
                    </div>
                    <div class="rp-tpl">
                        <span class="rp-tpl__ic rp-tpl__ic--blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M9 13h6M9 17h4"/></svg></span>
                        <div class="rp-tpl__name">Team Lead Template</div>
                        <div class="rp-tpl__desc">Team lead permissions</div>
                        <button class="rp-tpl__btn" type="button" data-tpl-open="1" data-tpl-name="Team Lead Template">Use Template</button>
                    </div>
                    <div class="rp-tpl">
                        <span class="rp-tpl__ic rp-tpl__ic--orange"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M9 13h6M9 17h4"/></svg></span>
                        <div class="rp-tpl__name">Manager Template</div>
                        <div class="rp-tpl__desc">Manager level permissions</div>
                        <button class="rp-tpl__btn" type="button" data-tpl-open="1" data-tpl-name="Manager Template">Use Template</button>
                    </div>
                    <div class="rp-tpl">
                        <span class="rp-tpl__ic rp-tpl__ic--green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M9 13h6M9 17h4"/></svg></span>
                        <div class="rp-tpl__name">Finance Template</div>
                        <div class="rp-tpl__desc">Finance related permissions</div>
                        <button class="rp-tpl__btn" type="button" data-tpl-open="1" data-tpl-name="Finance Template">Use Template</button>
                    </div>
                    <div class="rp-tpl">
                        <span class="rp-tpl__ic rp-tpl__ic--purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M12 5v14M5 12h14"/></svg></span>
                        <div class="rp-tpl__name">Custom Role</div>
                        <div class="rp-tpl__desc">Create from scratch</div>
                        <button class="rp-tpl__btn" type="button" data-tpl-open="1" data-tpl-name="Custom Role">Start Fresh</button>
                    </div>
                </div>
            </div>

            <!-- Roles table -->
            <div class="rp-table-card">
                <div class="rp-table-top">
                    <div class="rp-search">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="11" cy="11" r="7"/><path d="m21 21-4-4"/></svg>
                        <input type="text" placeholder="Search roles..."/>
                    </div>
                    <div class="rp-view">
                        <span class="rp-view__label">View:</span>
                        <div class="seg rp-view__seg">
                            <button class="seg__btn is-active" type="button">List</button>
                            <button class="seg__btn" type="button">Grid</button>
                        </div>
                    </div>
                </div>

                <div class="rp-tablewrap">
                    <table class="rp-table">
                        <thead>
                            <tr>
                                <th>Role Name</th>
                                <th>Users</th>
                                <th>Permissions</th>
                                <th>Access Scope</th>
                                <th class="rp-ta-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="roles" t-as="r">
                                <tr>
                                    <td>
                                        <div class="rp-role">
                                            <span class="rp-av" t-attf-style="background:#{r['av']}"><t t-out="r['letter']"/></span>
                                            <div>
                                                <div class="rp-role__name"><t t-out="r['name']"/></div>
                                                <div class="rp-role__desc"><t t-out="r['desc']"/></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="rp-users"><t t-out="r['users']"/></td>
                                    <td>
                                        <t t-if="r['all_access']">
                                            <span class="rp-allaccess">All Access</span>
                                        </t>
                                        <t t-else="">
                                            <span class="rp-perms"><t t-out="r['perms']"/></span>
                                        </t>
                                    </td>
                                    <td><span class="rp-scope"><t t-out="r['scope']"/></span></td>
                                    <td>
                                        <span class="rp-actions">
                                            <button class="rp-act" type="button" title="Edit">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                            </button>
                                            <button class="rp-act" type="button" title="Duplicate">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
                                            </button>
                                            <button class="rp-act" type="button" title="Delete">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6M10 11v6M14 11v6"/></svg>
                                            </button>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <div class="rp-foot">
                    <span class="rp-foot__info">Showing 1 to 7 of 7 roles</span>
                </div>
            </div>

            <!-- ===== Create from HR Template wizard modal ("Use Template" se khulta hai) ===== -->
            <div class="nr-modal rtpl-modal" data-tpl-modal="1" data-current-step="1">
                <div class="nr-modal__overlay" data-tpl-close="1"></div>
                <div class="nr-modal__dialog">
                    <div class="rtpl-head">
                        <div>
                            <h2 class="rtpl-head__title" data-tpl-title="1">Create from HR Template</h2>
                            <p class="rtpl-head__sub" data-step-label="1">Step 1 of 4</p>
                        </div>
                        <button class="rtpl-head__x" type="button" data-tpl-close="1">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" xmlns="http://www.w3.org/2000/svg"><path d="M18 6 6 18M6 6l12 12"/></svg>
                        </button>
                    </div>

                    <div class="rtpl-steps">
                        <div class="rtpl-step is-active" data-ind="1">
                            <span class="rtpl-step__num">
                                <span class="rtpl-step__n">1</span>
                                <svg class="rtpl-step__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5"/></svg>
                            </span>
                            <span class="rtpl-step__label">Basic Info</span>
                        </div>
                        <span class="rtpl-step__line" data-line="1"></span>
                        <div class="rtpl-step" data-ind="2">
                            <span class="rtpl-step__num">
                                <span class="rtpl-step__n">2</span>
                                <svg class="rtpl-step__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5"/></svg>
                            </span>
                            <span class="rtpl-step__label">Permissions</span>
                        </div>
                        <span class="rtpl-step__line" data-line="2"></span>
                        <div class="rtpl-step" data-ind="3">
                            <span class="rtpl-step__num">
                                <span class="rtpl-step__n">3</span>
                                <svg class="rtpl-step__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5"/></svg>
                            </span>
                            <span class="rtpl-step__label">Access Level</span>
                        </div>
                        <span class="rtpl-step__line" data-line="3"></span>
                        <div class="rtpl-step" data-ind="4">
                            <span class="rtpl-step__num">
                                <span class="rtpl-step__n">4</span>
                                <svg class="rtpl-step__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5"/></svg>
                            </span>
                            <span class="rtpl-step__label">Review</span>
                        </div>
                    </div>

                    <div class="rtpl-body">
                        <!-- STEP 1 — Basic Info -->
                        <div data-step-panel="1">
                            <h3 class="rtpl-body__title">Basic Information</h3>
                            <div class="rtpl-field">
                                <label class="ea-label">Role Name <span class="ea-req">*</span></label>
                                <input class="ea-input" type="text" placeholder="Enter role name"/>
                            </div>
                            <div class="rtpl-field">
                                <label class="ea-label">Description</label>
                                <textarea class="ea-textarea" data-tpl-desc="1">Pre-filled from HR Template</textarea>
                            </div>
                            <div class="rtpl-row2">
                                <div class="rtpl-field">
                                    <label class="ea-label">Department (Optional)</label>
                                    <div class="wl-caret">
                                        <select class="wl-select">
                                            <option value="" selected="selected" disabled="disabled">Select Department</option>
                                            <option>Human Resources</option>
                                            <option>Finance</option>
                                            <option>Engineering</option>
                                            <option>Sales</option>
                                        </select>
                                        <span class="wl-caret__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="m6 9 6 6 6-6"/></svg></span>
                                    </div>
                                </div>
                                <div class="rtpl-field">
                                    <label class="ea-label">Reports To (Optional)</label>
                                    <div class="wl-caret">
                                        <select class="wl-select">
                                            <option value="" selected="selected" disabled="disabled">Select Role</option>
                                            <option>CEO</option>
                                            <option>HR</option>
                                            <option>Manager</option>
                                            <option>Team Lead</option>
                                        </select>
                                        <span class="wl-caret__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="m6 9 6 6 6-6"/></svg></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- STEP 2 — Permissions -->
                        <div data-step-panel="2" style="display:none">
                            <div class="rtpl-permbar">
                                <div class="rtpl-search">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="11" cy="11" r="7"/><path d="m21 21-4-4"/></svg>
                                    <input type="text" placeholder="Search permissions..."/>
                                </div>
                                <button class="rtpl-selectall" type="button">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="m8 12 3 3 5-6"/></svg>
                                    Select All
                                </button>
                            </div>
                            <div class="rtpl-permgrid">
                                <div class="rtpl-cats">
                                    <a class="rtpl-cat is-active" href="#">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="9" cy="8" r="3.2"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 5.2a3.2 3.2 0 0 1 0 6.1M21.5 20a6 6 0 0 0-4.5-5.8"/></svg>
                                        Employees <span class="rtpl-cat__badge">3</span>
                                    </a>
                                    <a class="rtpl-cat" href="#">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/></svg>
                                        Attendance
                                    </a>
                                    <a class="rtpl-cat" href="#">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M8 2v4M16 2v4M3 9h18M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/></svg>
                                        Leave
                                    </a>
                                    <a class="rtpl-cat" href="#">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 14h3"/></svg>
                                        Payroll
                                    </a>
                                    <a class="rtpl-cat" href="#">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M3 17l6-6 4 4 7-7M17 8h4v4"/></svg>
                                        Performance
                                    </a>
                                    <a class="rtpl-cat" href="#">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/></svg>
                                        Reports
                                    </a>
                                    <a class="rtpl-cat" href="#">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/></svg>
                                        Settings
                                    </a>
                                </div>
                                <div class="rtpl-perms">
                                    <div class="rtpl-perms__head">
                                        <span class="rtpl-perms__cat">Employees</span>
                                        <span class="rtpl-perms__sel">3 of 4 selected · <a href="#">Select all</a></span>
                                    </div>
                                    <label class="rtpl-perm">
                                        <input type="checkbox" checked="checked"/>
                                        <span class="rtpl-perm__box"></span>
                                        <div class="rtpl-perm__body">
                                            <div class="rtpl-perm__title">View Employees</div>
                                            <div class="rtpl-perm__desc">Can view employee list and details</div>
                                        </div>
                                        <span class="rtpl-perm__dot"></span>
                                    </label>
                                    <label class="rtpl-perm">
                                        <input type="checkbox" checked="checked"/>
                                        <span class="rtpl-perm__box"></span>
                                        <div class="rtpl-perm__body">
                                            <div class="rtpl-perm__title rtpl-perm__title--blue">Add Employees</div>
                                            <div class="rtpl-perm__desc">Can add new employees</div>
                                        </div>
                                        <span class="rtpl-perm__dot"></span>
                                    </label>
                                    <label class="rtpl-perm">
                                        <input type="checkbox" checked="checked"/>
                                        <span class="rtpl-perm__box"></span>
                                        <div class="rtpl-perm__body">
                                            <div class="rtpl-perm__title">Edit Employees</div>
                                            <div class="rtpl-perm__desc">Can edit employee information</div>
                                        </div>
                                        <span class="rtpl-perm__dot"></span>
                                    </label>
                                    <label class="rtpl-perm">
                                        <input type="checkbox"/>
                                        <span class="rtpl-perm__box"></span>
                                        <div class="rtpl-perm__body">
                                            <div class="rtpl-perm__title">Delete Employees</div>
                                            <div class="rtpl-perm__desc">Can delete employee records</div>
                                        </div>
                                        <span class="rtpl-perm__dot"></span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- STEP 3 — Access Level -->
                        <div data-step-panel="3" style="display:none">
                            <h3 class="rtpl-body__title">Access Scope</h3>
                            <p class="rtpl-ascope__sub">Define the level of data access for this role</p>
                            <div class="rtpl-acards">
                                <label class="rtpl-acard">
                                    <input type="radio" name="rtpl_scope" data-scope="Own Data Only" checked="checked"/>
                                    <span class="rtpl-acard__radio"></span>
                                    <span class="rtpl-acard__ic"></span>
                                    <div class="rtpl-acard__body">
                                        <div class="rtpl-acard__title">Own Data Only</div>
                                        <div class="rtpl-acard__desc">Can access and manage only their own data</div>
                                    </div>
                                </label>
                                <label class="rtpl-acard">
                                    <input type="radio" name="rtpl_scope" data-scope="Team Members"/>
                                    <span class="rtpl-acard__radio"></span>
                                    <span class="rtpl-acard__ic"></span>
                                    <div class="rtpl-acard__body">
                                        <div class="rtpl-acard__title">Team Members</div>
                                        <div class="rtpl-acard__desc">Can access and manage team members' data</div>
                                    </div>
                                </label>
                                <label class="rtpl-acard">
                                    <input type="radio" name="rtpl_scope" data-scope="Department Only"/>
                                    <span class="rtpl-acard__radio"></span>
                                    <span class="rtpl-acard__ic"></span>
                                    <div class="rtpl-acard__body">
                                        <div class="rtpl-acard__title">Department Only</div>
                                        <div class="rtpl-acard__desc">Can access department-wide data</div>
                                    </div>
                                </label>
                                <label class="rtpl-acard">
                                    <input type="radio" name="rtpl_scope" data-scope="Entire Organization"/>
                                    <span class="rtpl-acard__radio"></span>
                                    <span class="rtpl-acard__ic"></span>
                                    <div class="rtpl-acard__body">
                                        <div class="rtpl-acard__title">Entire Organization</div>
                                        <div class="rtpl-acard__desc">Can access all data across organization</div>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- STEP 4 — Review -->
                        <div data-step-panel="4" style="display:none">
