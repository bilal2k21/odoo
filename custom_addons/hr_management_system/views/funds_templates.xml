<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         FUNDS REQUEST  (/requests/funds)
    ============================================================= -->
    <template id="funds_page" name="Funds Request">
        <t t-set="active" t-value="'requests'"/>
        <t t-set="section" t-value="'Requests'"/>
        <t t-set="page_name" t-value="'Funds Request'"/>
        <t t-call="hr_management_system.dashboard_layout">

            <div class="req-head">
                <h1 class="req-head__title">Funds Request</h1>
                <p class="req-head__sub">Submit a time-off, reimbursement, or asset request for approval.</p>
            </div>

            <!-- Tabs -->
            <div class="req-tabs">
                <a class="req-tab" href="/requests">Attendence Request</a>
                <a class="req-tab" href="/requests/leave">Leave</a>
                <a class="req-tab" href="/requests/expense">Expense Request</a>
                <span class="req-tab is-active">Funds Request</span>
                <a class="req-tab" href="/requests/employ-action">Employ Action Sheet</a>
                <span class="req-tab">Assets Request</span>
                <span class="req-tab">Document
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="m6 9 6 6 6-6"/></svg>
                </span>
            </div>

            <div class="exp-card">
                <div class="exp-card__head">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="6" width="20" height="13" rx="2"/><path d="M2 10h20M6 15h4"/></svg>
                    Funds Request
                    <span class="fr-salary">Salary: <span class="fr-salary__badge">$50,000</span></span>
                </div>

                <!-- Row: Employee / Code / Request Type -->
                <div class="fr-grid3">
                    <div class="ea-field">
                        <label class="ea-label">Employee <span class="ea-req">*</span></label>
                        <input type="text" class="ea-input" value="MV-074 - Muhammad - Asim"/>
                    </div>
                    <div class="ea-field exp-amount">
                        <label class="ea-label">Employee Code</label>
                        <input type="text" class="ea-input" value="MV-074" readonly="readonly"/>
                    </div>
                    <div class="ea-field">
                        <label class="ea-label">Select Request Type <span class="ea-req">*</span></label>
                        <input type="text" class="ea-input" value="Loan"/>
                    </div>
                </div>

                <!-- Row: Amount / Loan Taken Date -->
                <div class="fr-grid3" style="margin-top:18px">
                    <div class="ea-field">
                        <label class="ea-label">Amount <span class="ea-req">*</span></label>
                        <div class="fr-prefixed"><span class="fr-prefixed__p">RS</span><input type="text" value="20000"/></div>
                    </div>
                    <div class="ea-field exp-date">
                        <label class="ea-label">Loan Taken Date <span class="ea-req">*</span></label>
                        <input type="text" class="ea-input" value="13/05/2026" readonly="readonly"/>
                        <span class="exp-date__icons">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M18 6 6 18M6 6l12 12"/></svg>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/></svg>
                        </span>
                    </div>
                    <div></div>
                </div>

                <!-- Description -->
                <div class="ea-field" style="margin-top:18px">
                    <label class="ea-label">Description <span class="ea-req">*</span></label>
                    <input type="text" class="ea-input" value="Its Check Amount"/>
                </div>

                <!-- Loan Recovery details -->
                <div class="fr-section-title">Loan Recovery details</div>
                <hr class="fr-divider"/>

                <div class="exp-grid4">
                    <div class="ea-field">
                        <label class="ea-label">Deduction Value <span class="ea-req">*</span></label>
                        <div class="fr-prefixed"><span class="fr-prefixed__p">%</span><input type="text" value="10"/></div>
                    </div>
                    <div class="ea-field">
                        <label class="ea-label">Loan Recovery Method <span class="ea-req">*</span></label>
                        <input type="text" class="ea-input" value="Salary"/>
                    </div>
                    <div class="ea-field">
                        <label class="ea-label">Payment Installment Amount <span class="ea-req">*</span></label>
                        <input type="text" class="ea-input" value="Percentage of Basic Salary"/>
                    </div>
                    <div class="ea-field">
                        <label class="ea-label">Payment Start Date <span class="ea-req">*</span></label>
                        <div class="nr-caret">
                            <input type="text" class="ea-input" placeholder="DD/MM/YYYY"/>
                            <span class="nr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/></svg></span>
                        </div>
                    </div>

                    <div class="ea-field">
                        <label class="ea-label">Recovery Loan Amount <span class="ea-req">*</span></label>
                        <div class="fr-prefixed"><span class="fr-prefixed__p">RS</span><input type="text" value="20000"/></div>
                    </div>
                    <div class="ea-field exp-amount">
                        <label class="ea-label">Installment By Base Salary</label>
                        <input type="text" class="ea-input" value="7500" readonly="readonly"/>
                    </div>
                </div>

                <!-- Footer -->
                <div class="eas-foot">
                    <button type="button" class="eas-cancel">Cancel</button>
                    <button type="button" class="eas-save">Save</button>
                </div>
            </div>
        </t>
    </template>

</odoo>
