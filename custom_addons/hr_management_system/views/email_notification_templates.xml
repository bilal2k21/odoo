<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         SETTINGS → EMAIL NOTIFICATION  (/settings/email-notification)
    ============================================================= -->
    <template id="email_notification_page" name="Email Notification">
        <t t-set="active" t-value="'settings'"/>
        <t t-set="section" t-value="'Settings'"/>
        <t t-set="subsection" t-value="'Setup'"/>
        <t t-set="page_name" t-value="'Email Notification'"/>
        <t t-call="hr_management_system.dashboard_layout">

            <div class="en-head">
                <div>
                    <h1 class="set-head__title">Email Notification</h1>
                    <p class="set-head__sub">Configure which events trigger automated emails and who receives them.</p>
                </div>
                <div class="en-head__btns">
                    <button class="en-cancel" type="button">Cancel</button>
                    <button class="en-save" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5"/></svg>
                        Save Changes
                    </button>
                </div>
            </div>

            <!-- Sender settings -->
            <div class="en-card">
                <div class="en-card__head">
                    <h2 class="en-card__title">Sender Settings</h2>
                    <p class="en-card__sub">How outgoing emails appear to recipients.</p>
                </div>
                <div class="en-grid3">
                    <div class="en-field">
                        <label class="ea-label">From Name</label>
                        <input class="ea-input" type="text" value="Metaviz HR"/>
                    </div>
                    <div class="en-field">
                        <label class="ea-label">From Email</label>
                        <input class="ea-input" type="text" value="no-reply@metaviz.pro"/>
                    </div>
                    <div class="en-field">
                        <label class="ea-label">Reply-To Email</label>
                        <input class="ea-input" type="text" value="hr@metaviz.pro"/>
                    </div>
                </div>
            </div>

            <!-- Notification events -->
            <div class="en-card">
                <div class="en-card__head en-card__head--row">
                    <div>
                        <h2 class="en-card__title">Notification Events</h2>
                        <p class="en-card__sub">Turn individual email notifications on or off.</p>
                    </div>
                    <span class="en-count">6 of 8 enabled</span>
                </div>

                <div class="en-events">
                    <div class="en-event">
                        <span class="en-event__ic en-event__ic--green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="9" cy="8" r="3.2"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M19 8v6M16 11h6"/></svg></span>
                        <div class="en-event__body">
                            <div class="en-event__title">Employee Onboarding</div>
                            <div class="en-event__desc">Send a welcome email when a new employee is added.</div>
                        </div>
                        <span class="en-event__chip">Email</span>
                        <label class="adoc-switch">
                            <input type="checkbox" checked="checked"/>
                            <span class="adoc-switch__t"></span>
                        </label>
                    </div>

                    <div class="en-event">
                        <span class="en-event__ic en-event__ic--blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M8 2v4M16 2v4M3 9h18M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/></svg></span>
                        <div class="en-event__body">
                            <div class="en-event__title">Leave Request Submitted</div>
                            <div class="en-event__desc">Notify managers when an employee applies for leave.</div>
                        </div>
                        <span class="en-event__chip">Email</span>
                        <label class="adoc-switch">
                            <input type="checkbox" checked="checked"/>
                            <span class="adoc-switch__t"></span>
                        </label>
                    </div>

                    <div class="en-event">
                        <span class="en-event__ic en-event__ic--teal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg></span>
                        <div class="en-event__body">
                            <div class="en-event__title">Leave Approved / Rejected</div>
                            <div class="en-event__desc">Notify the employee when their leave is actioned.</div>
                        </div>
                        <span class="en-event__chip">Email</span>
                        <label class="adoc-switch">
                            <input type="checkbox" checked="checked"/>
                            <span class="adoc-switch__t"></span>
                        </label>
                    </div>

                    <div class="en-event">
                        <span class="en-event__ic en-event__ic--orange"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
                        <div class="en-event__body">
                            <div class="en-event__title">Attendance Regulation</div>
                            <div class="en-event__desc">Notify on attendance correction requests.</div>
                        </div>
                        <span class="en-event__chip">Email</span>
                        <label class="adoc-switch">
                            <input type="checkbox"/>
                            <span class="adoc-switch__t"></span>
                        </label>
                    </div>

                    <div class="en-event">
                        <span class="en-event__ic en-event__ic--purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 14h3"/></svg></span>
                        <div class="en-event__body">
                            <div class="en-event__title">Payroll Generated</div>
                            <div class="en-event__desc">Email payslips when payroll is processed.</div>
                        </div>
                        <span class="en-event__chip">Email</span>
                        <label class="adoc-switch">
                            <input type="checkbox" checked="checked"/>
                            <span class="adoc-switch__t"></span>
                        </label>
                    </div>

                    <div class="en-event">
                        <span class="en-event__ic en-event__ic--red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M12 11v4M12 18h.01"/></svg></span>
                        <div class="en-event__body">
                            <div class="en-event__title">Document Expiry</div>
                            <div class="en-event__desc">Alert owners before a document expires.</div>
                        </div>
                        <span class="en-event__chip">Email</span>
                        <label class="adoc-switch">
                            <input type="checkbox" checked="checked"/>
                            <span class="adoc-switch__t"></span>
                        </label>
                    </div>

                    <div class="en-event">
                        <span class="en-event__ic en-event__ic--pink"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20 12v10H4V12M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7ZM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7Z"/></svg></span>
                        <div class="en-event__body">
                            <div class="en-event__title">Birthday &amp; Anniversary</div>
                            <div class="en-event__desc">Send celebration emails to the team.</div>
                        </div>
                        <span class="en-event__chip">Email</span>
                        <label class="adoc-switch">
                            <input type="checkbox"/>
                            <span class="adoc-switch__t"></span>
                        </label>
                    </div>

                    <div class="en-event">
                        <span class="en-event__ic en-event__ic--dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></span>
                        <div class="en-event__body">
                            <div class="en-event__title">Asset Assigned</div>
                            <div class="en-event__desc">Notify an employee when an asset is assigned to them.</div>
                        </div>
                        <span class="en-event__chip">Email</span>
                        <label class="adoc-switch">
                            <input type="checkbox" checked="checked"/>
                            <span class="adoc-switch__t"></span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- floating chat bubble -->
            <button class="cp-fab" type="button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 11.5a8.5 8.5 0 0 1-12.2 7.7L3 21l1.8-5.8A8.5 8.5 0 1 1 21 11.5Z"/><path d="M8.5 11h.01M12 11h.01M15.5 11h.01"/></svg>
            </button>
        </t>
    </template>

</odoo>
