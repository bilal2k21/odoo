<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         REPORTS  (/reports)
    ============================================================= -->
    <template id="reports_page" name="Reports">
        <t t-set="active" t-value="'reports'"/>
        <t t-set="topbar_hide" t-value="True"/>
        <t t-set="page_name" t-value="'Reports'"/>
        <t t-call="hr_management_system.dashboard_layout">

            <div class="rep-head">
                <div>
                    <h1 class="set-head__title">Reports</h1>
                    <p class="set-head__sub">Generate, schedule and download reports across every HR module.</p>
                </div>
                <button class="rep-new" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M12 5v14M5 12h14"/></svg>
                    New Report
                </button>
            </div>

            <!-- Stat cards (reuse .rp-stats/.rp-stat) -->
            <div class="rp-stats">
                <div class="rp-stat">
                    <div class="rp-stat__label">Available Reports</div>
                    <div class="rp-stat__row">
                        <span class="rp-stat__ic rp-stat__ic--blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/></svg></span>
                        <span class="rp-stat__num">8</span>
                    </div>
                </div>
                <div class="rp-stat">
                    <div class="rp-stat__label">Generated This Month</div>
                    <div class="rp-stat__row">
                        <span class="rp-stat__ic rp-stat__ic--green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M3 17l6-6 4 4 7-7M17 8h4v4"/></svg></span>
                        <span class="rp-stat__num">42</span>
                    </div>
                </div>
                <div class="rp-stat">
                    <div class="rp-stat__label">Scheduled</div>
                    <div class="rp-stat__row">
                        <span class="rp-stat__ic rp-stat__ic--orange"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
                        <span class="rp-stat__num">5</span>
                    </div>
                </div>
                <div class="rp-stat">
                    <div class="rp-stat__label">Downloads</div>
                    <div class="rp-stat__row">
                        <span class="rp-stat__ic rp-stat__ic--purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M12 3v12M8 11l4 4 4-4M4 21h16"/></svg></span>
                        <span class="rp-stat__num">1,026</span>
                    </div>
                </div>
            </div>

            <!-- Report categories -->
            <div class="rep-section">
                <h2 class="rep-section__title">Report Library</h2>
                <div class="rep-grid">
                    <div class="rep-cat">
                        <span class="rep-cat__ic rep-cat__ic--blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18M8.5 15.5l2 2 4-4"/></svg></span>
                        <div class="rep-cat__name">Attendance Report</div>
                        <div class="rep-cat__desc">Daily, weekly &amp; monthly attendance summaries.</div>
                        <span class="rep-cat__link">Generate <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                    </div>
                    <div class="rep-cat">
                        <span class="rep-cat__ic rep-cat__ic--purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 14h3"/></svg></span>
                        <div class="rep-cat__name">Payroll Report</div>
                        <div class="rep-cat__desc">Salary, deductions &amp; payslip summaries.</div>
                        <span class="rep-cat__link">Generate <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                    </div>
                    <div class="rep-cat">
                        <span class="rep-cat__ic rep-cat__ic--teal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M8 2v4M16 2v4M3 9h18M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/></svg></span>
                        <div class="rep-cat__name">Leave Report</div>
                        <div class="rep-cat__desc">Leave balances, usage &amp; trends.</div>
                        <span class="rep-cat__link">Generate <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                    </div>
                    <div class="rep-cat">
                        <span class="rep-cat__ic rep-cat__ic--green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="9" cy="8" r="3.2"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 5.2a3.2 3.2 0 0 1 0 6.1M21.5 20a6 6 0 0 0-4.5-5.8"/></svg></span>
                        <div class="rep-cat__name">Employee Directory</div>
                        <div class="rep-cat__desc">Headcount, demographics &amp; org structure.</div>
                        <span class="rep-cat__link">Generate <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                    </div>
                    <div class="rep-cat">
                        <span class="rep-cat__ic rep-cat__ic--orange"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="9" cy="8" r="3.2"/><path d="M3 20a6 6 0 0 1 11-3.2"/><path d="M19 8v6M16 11h6"/></svg></span>
                        <div class="rep-cat__name">Recruitment Report</div>
                        <div class="rep-cat__desc">Pipeline, hiring funnel &amp; time-to-hire.</div>
                        <span class="rep-cat__link">Generate <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                    </div>
                    <div class="rep-cat">
                        <span class="rep-cat__ic rep-cat__ic--dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></span>
                        <div class="rep-cat__name">Asset Report</div>
                        <div class="rep-cat__desc">Asset inventory, assignments &amp; status.</div>
                        <span class="rep-cat__link">Generate <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                    </div>
                    <div class="rep-cat">
                        <span class="rep-cat__ic rep-cat__ic--pink"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M3 17l6-6 4 4 7-7M17 8h4v4"/></svg></span>
                        <div class="rep-cat__name">Performance Report</div>
                        <div class="rep-cat__desc">Reviews, ratings &amp; goal tracking.</div>
                        <span class="rep-cat__link">Generate <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                    </div>
                    <div class="rep-cat">
                        <span class="rep-cat__ic rep-cat__ic--red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M9 7h6M9 11h6M9 15h4"/><rect x="5" y="3" width="14" height="18" rx="2"/></svg></span>
                        <div class="rep-cat__name">Expense Report</div>
                        <div class="rep-cat__desc">Reimbursements &amp; expense claims.</div>
                        <span class="rep-cat__link">Generate <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                    </div>
                </div>
            </div>

            <!-- Recent reports table -->
            <div class="rep-card">
                <div class="rep-card__head">
                    <h2 class="rep-card__title">Recent Reports</h2>
                    <a href="#" class="rep-card__all">View all</a>
                </div>
                <div class="rep-tablewrap">
                    <table class="rep-table">
                        <thead>
                            <tr>
                                <th>Report Name</th>
                                <th>Type</th>
                                <th>Generated On</th>
                                <th>Size</th>
                                <th class="rep-ta-right">Download</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="recent" t-as="r">
                                <tr>
                                    <td>
                                        <div class="rep-file">
                                            <span class="rep-file__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/></svg></span>
                                            <span class="rep-file__name"><t t-out="r['name']"/></span>
                                        </div>
                                    </td>
                                    <td><span t-attf-class="rep-type rep-type--#{r['tcls']}"><t t-out="r['type']"/></span></td>
                                    <td class="rep-date"><t t-out="r['date']"/></td>
                                    <td class="rep-size"><t t-out="r['size']"/></td>
                                    <td class="rep-dl-cell">
                                        <button class="rep-dl" type="button" title="Download">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M12 3v12M8 11l4 4 4-4M4 21h16"/></svg>
                                        </button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- floating chat bubble -->
            <button class="cp-fab" type="button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 11.5a8.5 8.5 0 0 1-12.2 7.7L3 21l1.8-5.8A8.5 8.5 0 1 1 21 11.5Z"/><path d="M8.5 11h.01M12 11h.01M15.5 11h.01"/></svg>
            </button>
        </t>
    </template>

</odoo>
