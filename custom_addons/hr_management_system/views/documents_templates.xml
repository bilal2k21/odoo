<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         COMPANY DOCUMENTS  (/documents)   Context: docs, expiring
    ============================================================= -->
    <template id="documents_page" name="Company Documents">
        <t t-set="active" t-value="'documents'"/>
        <t t-set="page_name" t-value="'Company Documents'"/>
        <t t-call="hr_management_system.dashboard_layout">

            <div class="rec-head">
                <div>
                    <h1 class="rec-head__title">Company Documents</h1>
                    <p class="rec-head__sub">486 documents across Metaviz Group · 23 require attention this month.</p>
                </div>
                <button type="button" class="btn-dark" data-doc-open="1">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M12 15V3M8 7l4-4 4 4M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/></svg>
                    Upload document
                </button>
            </div>

            <!-- KPIs -->
            <div class="rec-kpis">
                <div class="rec-kpi rec-kpi--teal">
                    <div class="rec-kpi__top">
                        <span class="rec-kpi__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/></svg></span>
                        <span class="rec-kpi__trend rec-kpi__trend--green">+18 this month</span>
                    </div>
                    <div class="rec-kpi__label">Total Documents</div>
                    <div class="rec-kpi__val">486</div>
                    <div class="rec-kpi__foot">across 7 categories</div>
                </div>
                <div class="rec-kpi rec-kpi--blue">
                    <div class="rec-kpi__top">
                        <span class="rec-kpi__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4"/></svg></span>
                        <span class="rec-kpi__trend rec-kpi__trend--muted">63%</span>
                    </div>
                    <div class="rec-kpi__label">Internal</div>
                    <div class="rec-kpi__val">307</div>
                    <div class="rec-kpi__foot">policies · HR · finance</div>
                </div>
                <div class="rec-kpi rec-kpi--purple">
                    <div class="rec-kpi__top">
                        <span class="rec-kpi__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg></span>
                        <span class="rec-kpi__trend rec-kpi__trend--muted">37%</span>
                    </div>
                    <div class="rec-kpi__label">External</div>
                    <div class="rec-kpi__val">179</div>
                    <div class="rec-kpi__foot">vendors · legal · gov</div>
                </div>
                <div class="rec-kpi rec-kpi--orange">
                    <div class="rec-kpi__top">
                        <span class="rec-kpi__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
                        <span class="rec-kpi__trend rec-kpi__trend--orange">next 30 days</span>
                    </div>
                    <div class="rec-kpi__label">Expiring Soon</div>
                    <div class="rec-kpi__val">17</div>
                    <div class="rec-kpi__foot">renew before expiry</div>
                </div>
                <div class="rec-kpi rec-kpi--red">
                    <div class="rec-kpi__top">
                        <span class="rec-kpi__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="m12 3 9 16H3z"/><path d="M12 10v4M12 17h.01"/></svg></span>
                        <span class="rec-kpi__trend rec-kpi__trend--red">action needed</span>
                    </div>
                    <div class="rec-kpi__label">Expired</div>
                    <div class="rec-kpi__val">6</div>
                    <div class="rec-kpi__foot">2 contracts · 4 certs</div>
                </div>
            </div>

            <!-- Quick access -->
            <div class="doc-quick__label">Quick Access</div>
            <div class="doc-quick">
                <span class="doc-chip doc-chip--blue"><span class="doc-chip__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4"/></svg></span><span class="doc-chip__name">Internal Documents</span><span class="doc-chip__n">307</span></span>
                <span class="doc-chip doc-chip--purple"><span class="doc-chip__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18"/></svg></span><span class="doc-chip__name">External Documents</span><span class="doc-chip__n">179</span></span>
                <span class="doc-chip doc-chip--orange"><span class="doc-chip__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><span class="doc-chip__name">Expiring Documents</span><span class="doc-chip__n">17</span></span>
                <span class="doc-chip doc-chip--gray"><span class="doc-chip__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8M10 12h4"/></svg></span><span class="doc-chip__name">Archived</span><span class="doc-chip__n">128</span></span>
            </div>

            <!-- Columns -->
            <div class="doc-cols">
                <div class="doc-main">
                    <div class="rec-card">
                        <div class="pay-card__head">
                            <div>
                                <div class="pay-card__title">Recent Documents</div>
                                <div class="pay-card__sub">Latest uploads &amp; updates across all categories</div>
                            </div>
                            <span class="pay-card__link">View all →</span>
                        </div>
                        <div class="rec-toolbar" style="margin:14px 18px">
                            <div class="rec-fpills">
                                <span class="rec-fpill is-active">All 6</span>
                                <span class="rec-fpill"><i style="background:#2f72c4"></i> Internal</span>
                                <span class="rec-fpill"><i style="background:#7c5cde"></i> External</span>
                            </div>
                            <div class="rec-right">
                                <div class="rec-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="11" cy="11" r="7"/><path d="m21 21-4-4"/></svg><input type="text" placeholder="Filter documents..."/></div>
                            </div>
                        </div>
                        <table class="rec-table">
                            <thead><tr><th>Document</th><th>Category</th><th>Type</th><th>Uploaded By</th><th>Date</th><th>Status</th></tr></thead>
                            <tbody>
                                <t t-foreach="docs" t-as="d">
                                    <tr>
                                        <td><div class="doc-docname"><span t-attf-class="doc-file doc-file--#{d['f']}"><t t-out="d['f'].upper()"/></span><div><div class="doc-name"><t t-out="d['nm']"/></div><div class="doc-meta"><t t-out="d['mt']"/></div></div></div></td>
                                        <td><span class="doc-cat" t-attf-style="color:#{d['cc']}"><t t-out="d['cat']"/></span></td>
                                        <td><span t-attf-class="doc-type doc-type--#{d['ty']}"><t t-out="d['tl']"/></span></td>
                                        <td><span class="doc-up"><span class="doc-up__av" t-attf-style="background:#{d['uc']}"><t t-out="d['ua']"/></span><span class="doc-up__name"><t t-out="d['up']"/></span></span></td>
                                        <td><t t-out="d['dt']"/></td>
                                        <td><span t-attf-class="doc-status doc-status--#{d['st']}"><t t-out="d['sl']"/></span></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <div class="pay-foot">
                            <span class="pay-foot__info">Showing 6 of 486 documents</span>
                            <div class="pay-pager"><a href="#">‹</a><span class="is-active">1</span><a href="#">2</a><a href="#">3</a><span class="dots">…</span><a href="#">81</a><a href="#">›</a></div>
                        </div>
                    </div>
                </div>

                <!-- Recent activity -->
                <div class="doc-side">
                    <div class="rec-card" style="padding:0">
                        <div class="pay-card__head">
                            <div><div class="pay-card__title">Recent Activity</div><div class="pay-card__sub">Last 24 hours</div></div>
                            <span class="pay-card__link">View all</span>
                        </div>
                        <div style="padding:6px 18px">
                            <t t-foreach="[
                                {'ic':'green','a':'uploaded','who':'Mujahid Ali','what':'Remote Work Policy 2026','meta':'Policies · Internal · 12 min ago'},
                                {'ic':'blue','a':'edited','who':'Ayesha Khan','what':'Employee Handbook v8','meta':'HR · Draft saved · 48 min ago'},
                                {'ic':'teal','a':'renewed','who':'Bilal Ahmed','what':'AWS Master Service Agreement','meta':'Contracts · 12 months · 2 h ago'},
                                {'ic':'orange','a':'archived','who':'Usman Tariq','what':'Employee Handbook v7','meta':'HR · superseded by v8 · 3 h ago'},
                                {'ic':'red','a':'flagged','who':'System','what':'Office Lease — Lahore HQ','meta':'Expires in 10 days · 5 h ago'},
                                {'ic':'green','a':'uploaded','who':'Hamza Iqbal','what':'Fire Safety Inspection Report','meta':'Health &amp; Safety · External · Yesterday'}
                            ]" t-as="a">
                                <div class="ra-item">
                                    <span t-attf-class="ra-ic ra-c-#{a['ic']}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/></svg></span>
                                    <div class="ra-body">
                                        <div class="ra-title"><t t-out="a['who']"/> <span style="font-weight:400;color:#8a97a0"><t t-out="a['a']"/></span> <t t-out="a['what']"/></div>
                                        <div class="ra-meta"><t t-out="a['meta']"/></div>
                                    </div>
                                </div>
                            </t>
                        </div>
                        <div class="doc-foot" style="border-top:1px solid #f1f4f6">Audit log retained for 7 years</div>
                    </div>
                </div>
            </div>

            <!-- Expiring Soon -->
            <div class="rec-card">
                <div class="pay-card__head">
                    <div><div class="pay-card__title">Expiring Soon</div><div class="pay-card__sub">Documents nearing their expiry date · next 30 days</div></div>
                    <span class="pay-card__link">View all →</span>
                </div>
                <table class="rec-table">
                    <thead><tr><th>Document</th><th>Expiry Date</th><th>Days Remaining</th><th>Status</th></tr></thead>
                    <tbody>
                        <t t-foreach="expiring" t-as="e">
                            <tr>
                                <td><div class="doc-docname"><span t-attf-class="doc-file doc-file--#{e['f']}"><t t-out="e['f'].upper()"/></span><div><div class="doc-name"><t t-out="e['nm']"/></div><div class="doc-meta"><t t-out="e['mt']"/></div></div></div></td>
                                <td><t t-out="e['ed']"/></td>
                                <td><span t-attf-class="doc-days doc-days--#{e['dc']}"><t t-out="e['dr']"/></span></td>
                                <td><span class="doc-pill">Expiring</span></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <div class="doc-foot">17 documents expiring within 30 days</div>
            </div>

            <!-- ============ ADD NEW DOCUMENT modal ============ -->
            <div class="nr-modal nr-modal--wide" data-doc-modal="1">
                <div class="nr-modal__overlay" data-doc-close="1"></div>
                <div class="nr-modal__dialog">
                    <div class="nr-modal__head">
                        <div>
                            <h2 class="nr-modal__title">Add new document</h2>
                            <p class="nr-modal__sub">Upload a file and set its metadata, access, and renewal details. The preview updates as you type.</p>
                        </div>
                        <button class="nr-modal__x" type="button" data-doc-close="1">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" xmlns="http://www.w3.org/2000/svg"><path d="M18 6 6 18M6 6l12 12"/></svg>
                        </button>
                    </div>
                    <div class="nr-modal__body">
                        <div class="adoc-grid">
                            <!-- LEFT: form -->
                            <div class="adoc-form">
                                <div class="adoc-sec">
                                    <div class="adoc-sec__label">Basic Information</div>
                                    <div class="adoc-field"><label class="ea-label">Document name <span class="ea-req">*</span></label><input type="text" class="ea-input" value="Remote Work Policy 2026"/></div>
                                    <div class="adoc-field"><label class="ea-label">Description</label><textarea class="ea-textarea">Company-wide policy defining eligibility, expectations, and security requirements for remote and hybrid work arrangements.</textarea></div>
                                    <div class="adoc-row2">
                                        <div class="adoc-field"><label class="ea-label">Category <span class="ea-req">*</span></label><input type="text" class="ea-input" value="Policies"/></div>
                                        <div class="adoc-field"><label class="ea-label">Department</label><input type="text" class="ea-input" value="People &amp; Culture"/></div>
                                    </div>
                                    <div class="adoc-field">
                                        <label class="ea-label">Document type <span class="ea-req">*</span></label>
                                        <div class="adoc-type">
                                            <span class="adoc-type__opt"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="m3 11 9-8 9 8"/><path d="M5 9v11h14V9"/></svg> Internal</span>
                                            <span class="adoc-type__opt is-active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18"/></svg> External</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="adoc-sec">
                                    <div class="adoc-sec__label">Document Details</div>
                                    <div class="adoc-row3">
                                        <div><label class="ea-label">Version</label><input type="text" class="ea-input" value="v1.0"/></div>
                                        <div><label class="ea-label">Issue date</label><input type="date" class="ea-input" value="2026-06-29"/></div>
                                        <div><label class="ea-label">Expiry date</label><input type="date" class="ea-input"/></div>
                                    </div>
                                    <div class="adoc-row2" style="margin-top:16px">
                                        <div><label class="ea-label">Document number</label><input type="text" class="ea-input" value="POL-2026-014"/></div>
                                        <div><label class="ea-label">Issuing authority <span style="color:#8a97a0;font-weight:400">(external only)</span></label><input type="text" class="ea-input" placeholder="e.g. SECP, ISO, vendor name..."/></div>
                                    </div>
                                </div>

                                <div class="adoc-sec">
                                    <div class="adoc-sec__label">Access</div>
                                    <div class="adoc-row2">
                                        <div><label class="ea-label">Owner <span class="ea-req">*</span></label><input type="text" class="ea-input" value="Mujahid Ali - Head of HR"/></div>
                                        <div><label class="ea-label">Visibility</label><input type="text" class="ea-input" value="HR &amp; owners only"/></div>
                                    </div>
                                    <div style="margin-top:12px">
                                        <div class="adoc-access">
                                            <span class="adoc-access__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M12 3v12M8 11l4 4 4-4M4 21h16"/></svg></span>
                                            <div class="adoc-access__body"><div class="adoc-access__title">Allow download</div><div class="adoc-access__desc">Members with access can save a local copy</div></div>
                                            <label class="adoc-switch"><input type="checkbox" checked="checked"/><span class="adoc-switch__t"></span></label>
                                        </div>
                                        <div class="adoc-access">
                                            <span class="adoc-access__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></span>
                                            <div class="adoc-access__body"><div class="adoc-access__title">Allow editing</div><div class="adoc-access__desc">Owners and editors can upload new versions</div></div>
                                            <label class="adoc-switch"><input type="checkbox"/><span class="adoc-switch__t"></span></label>
                                        </div>
                                        <div class="adoc-access">
                                            <span class="adoc-access__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5"/></svg></span>
                                            <div class="adoc-access__body"><div class="adoc-access__title">Require acknowledgement</div><div class="adoc-access__desc">Employees must confirm they've read it</div></div>
                                            <label class="adoc-switch"><input type="checkbox" checked="checked"/><span class="adoc-switch__t"></span></label>
                                        </div>
                                    </div>
                                </div>

                                <div class="adoc-sec">
                                    <div class="adoc-sec__label">File</div>
                                    <div class="ea-drop">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M12 15V3M8 7l4-4 4 4"/><path d="M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/></svg>
                                        <div class="ea-drop__title">Drag &amp; drop a file here or browse</div>
                                        <div class="ea-drop__hint">PDF, DOCX, XLSX, PNG · up to 25 MB</div>
                                    </div>
                                    <div class="adoc-file">
                                        <span class="doc-file doc-file--pdf">PDF</span>
                                        <div><div class="adoc-file__name">Remote-Work-Policy-2026.pdf</div><div class="adoc-file__meta">PDF · 2.4 MB · attached just now</div></div>
                                        <span class="adoc-file__replace"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5"/></svg> Replace file</span>
                                    </div>
                                </div>
                            </div>

                            <!-- RIGHT: live preview -->
                            <div class="adoc-side">
                                <div class="adoc-preview">
                                    <div class="adoc-preview__head">
                                        <span class="doc-file doc-file--pdf">PDF</span>
                                        <div>
                                            <div class="adoc-preview__title">Remote Work Policy 2026</div>
                                            <div class="adoc-preview__tags"><span style="color:#7c5cde">External</span><span style="color:#2f72c4">Policies</span></div>
                                        </div>
                                    </div>
                                    <div class="adoc-pv-label">Live Preview</div>
                                    <div class="adoc-pv-row"><span>Version</span><b>v1.0</b></div>
                                    <div class="adoc-pv-row"><span>Document no.</span><b>POL-2026-014</b></div>
                                    <div class="adoc-pv-row"><span>Issue date</span><b>29 Jun 2026</b></div>
                                    <div class="adoc-pv-row"><span>Expiry</span><b>No expiry</b></div>
                                    <div class="adoc-pv-row"><span>Owner</span><b>Mujahid Ali</b></div>
                                    <div class="adoc-pv-row"><span>Visibility</span><b>HR &amp; owners only</b></div>
                                </div>
                                <div class="adoc-hint">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
                                    Set an expiry date for contracts, certificates, and licenses — they'll appear in the Expiring Soon list 30 days before lapsing.
                                </div>
                            </div>
                        </div>

                        <!-- footer -->
                        <div class="adoc-foot">
                            <span class="adoc-foot__auto"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5"/></svg> Draft autosaved 8s ago</span>
                            <button type="button" class="adoc-save" data-doc-close="1">Save draft</button>
                            <button type="button" class="adoc-publish"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5"/></svg> Publish document</button>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
