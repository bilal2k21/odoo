<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         ATTENDANCE DETAIL  (/attendance/employee)
         Context: cal (42 calendar cells)
    ============================================================= -->
    <template id="attendance_detail_page" name="Attendance Detail">
        <t t-set="active" t-value="'attendance'"/>
        <t t-set="section" t-value="'Attendance'"/>
        <t t-set="page_name" t-value="'Muhammad Asim'"/>
        <t t-call="hr_management_system.dashboard_layout">

            <!-- Top buttons -->
            <div class="ad-topbar">
                <a class="ad-back" href="/attendance">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="m15 18-6-6 6-6"/></svg>
                    Back to roster
                </a>
                <div class="ad-top-actions">
                    <button type="button" class="btn-ghost">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M12 3v12M8 11l4 4 4-4M4 21h16"/></svg>
                        Export PDF
                    </button>
                    <button type="button" class="btn-dark">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M12 5v14M5 12h14"/></svg>
                        Add attendance
                    </button>
                </div>
            </div>

            <!-- Employee header -->
            <div class="ad-emp">
                <div class="ad-emp__av">MA<span class="ad-emp__dot"></span></div>
                <div>
                    <div class="ad-emp__name">Muhammad Asim <span class="ad-emp__id">MV-001</span> <span class="ad-emp__role">Senior Frontend Engineer</span></div>
                    <div class="ad-emp__meta">
                        <span>Product Engineering</span>
                        <span>Reports to Wahab Butt</span>
                        <span>Lahore Office · 4F</span>
                        <span>Standard 09:00 – 18:00</span>
                    </div>
                    <div class="ad-emp__meta">
                        <span>Joined 12 Mar 2022</span>
                        <span>asim.altaf@metaviz.co</span>
                        <span>+92 300 412 8870</span>
                    </div>
                </div>
                <button type="button" class="ad-emp__email">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                    Email
                </button>
            </div>

            <!-- KPIs -->
            <div class="ad-kpis">
                <div class="ad-kpi ad-kpi--green">
                    <div class="ad-kpi__label">Worked</div>
                    <div class="ad-kpi__val">164.2 <small>h</small></div>
                    <div class="ad-kpi__bar"><span style="width:92%"></span></div>
                    <div class="ad-kpi__sub">92% of 178h target</div>
                </div>
                <div class="ad-kpi">
                    <div class="ad-kpi__label">Present Days</div>
                    <div class="ad-kpi__val">17 <small>/22</small></div>
                    <div class="ad-kpi__sub">5 off-days this month</div>
                </div>
                <div class="ad-kpi ad-kpi--orange">
                    <div class="ad-kpi__label">Late Arrivals</div>
                    <div class="ad-kpi__val">2</div>
                    <div class="ad-kpi__sub">134 min total · 1 flagged</div>
                </div>
                <div class="ad-kpi ad-kpi--red">
                    <div class="ad-kpi__label">Absent</div>
                    <div class="ad-kpi__val">1</div>
                    <div class="ad-kpi__sub">1 requires regularization</div>
                </div>
                <div class="ad-kpi ad-kpi--orange">
                    <div class="ad-kpi__label">Overtime</div>
                    <div class="ad-kpi__val">4.6 <small>h</small></div>
                    <div class="ad-kpi__sub">Approved 3.2h</div>
                </div>
                <div class="ad-kpi">
                    <div class="ad-kpi__label">Avg In / Out</div>
                    <div class="ad-kpi__val">09:08</div>
                    <div class="ad-kpi__sub">Avg out 18:23</div>
                </div>
            </div>

            <!-- Tabs -->
            <div class="ad-tabs">
                <span class="ad-tab is-active">Calendar</span>
                <span class="ad-tab">Timesheet <span class="ad-tab__n">22</span></span>
                <span class="ad-tab">Leaves <span class="ad-tab__n">3</span></span>
                <span class="ad-tab">Regularizations <span class="ad-tab__n">2</span></span>
                <span class="ad-tab">Documents</span>
            </div>

            <div class="ad-wrap">
                <!-- ============ LEFT: Calendar ============ -->
                <div class="ad-main">
                    <div class="ad-card">
                        <div class="cal-head">
                            <div>
                                <div class="ad-card__title">Monthly calendar</div>
                                <div class="ad-card__sub">Click any day to inspect punches. Late, regularized and overtime markers appear at the corner.</div>
                            </div>
                            <div class="cal-ctrl">
                                <div class="cal-seg">
                                    <span class="cal-seg__btn is-active">Month</span>
                                    <span class="cal-seg__btn">Week</span>
                                </div>
                                <span class="cal-month"><span class="cal-nav">‹</span> May 2026 <span class="cal-nav">›</span></span>
                            </div>
                        </div>

                        <div class="cal-grid">
                            <div class="cal-dow">SUN</div><div class="cal-dow">MON</div><div class="cal-dow">TUE</div><div class="cal-dow">WED</div><div class="cal-dow">THU</div><div class="cal-dow">FRI</div><div class="cal-dow">SAT</div>
                            <div t-foreach="cal" t-as="c" t-attf-class="cal-day is-#{c['st']}">
                                <div class="cal-day__n"><t t-out="'%02d' % c['n']"/></div>
                                <t t-if="c.get('sub')"><div class="cal-day__label"><t t-out="c['sub']"/></div></t>
                                <t t-if="c.get('label')"><div class="cal-day__label"><t t-out="c['label']"/></div></t>
                                <t t-if="c.get('hrs')"><div class="cal-day__hrs"><t t-out="c['hrs']"/></div></t>
                                <t t-if="c.get('dot')"><span class="cal-day__dot" t-attf-style="background:#{c['dot']}"></span></t>
                            </div>
                        </div>

                        <div class="cal-legend">
                            <span><i style="background:#eaf7ef;border:1px solid #16a34a"></i> Present</span>
                            <span><i style="background:#fdecea;border:1px solid #e5564b"></i> Absent</span>
                            <span><i style="background:#fdf3e4;border:1px solid #f29a2e"></i> Late</span>
                            <span><i style="background:#fff6ea;border:1px solid #c98a1d"></i> On leave</span>
                            <span><i style="background:#eaf1fb;border:1px solid #2f72c4"></i> Holiday</span>
                            <span><i style="background:#f4f6f8;border:1px solid #cfd6db"></i> Weekend</span>
                            <span><i class="dot" style="background:#0a7e9b"></i> regularized</span>
                            <span><i class="dot" style="background:#f29a2e"></i> late flag</span>
                        </div>
                    </div>
                </div>

                <!-- ============ RIGHT: panels ============ -->
                <div class="ad-side">

                    <!-- Day detail -->
                    <div class="ad-card">
                        <div class="dd-head">
                            <div>
                                <div class="ad-card__title">Day detail</div>
                                <div class="ad-card__sub">Click another day on the calendar to switch.</div>
                            </div>
                            <span class="cal-month"><span class="cal-nav">‹</span> <span class="cal-nav">›</span></span>
                        </div>
                        <div class="dd-row">
                            <span class="dd-date">06 May 2026</span>
                            <span class="dd-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5"/></svg> On time</span>
                        </div>
                        <div class="dd-shift">Wed · Standard shift 09:00 – 18:00</div>

                        <div class="dd-punch">
                            <div class="dd-punch__box">
                                <div class="dd-punch__label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg> Clock in</div>
                                <div class="dd-punch__time">09:01</div>
                                <div class="dd-punch__meta">Web · Office</div>
                            </div>
                            <div class="dd-punch__box">
                                <div class="dd-punch__label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg> Clock out</div>
                                <div class="dd-punch__time">—</div>
                                <div class="dd-punch__meta">In progress</div>
                            </div>
                        </div>

                        <div class="dd-prog">
                            <div class="dd-prog__top">Worked vs planned <b>4.2h / 8.5h</b></div>
                            <div class="dd-prog__bar"><span style="width:49%"></span></div>
                            <div class="dd-prog__scale"><span>09:00</span><span>13:00</span><span>18:00</span></div>
                        </div>

                        <div class="dd-tl">
                            <div class="dd-tl__label">Punch timeline</div>
                            <div class="dd-tl__item">
                                <span class="dd-tl__dot"></span>
                                <div style="flex:1">
                                    <div class="dd-tl__title">Clocked in <span>09:01</span></div>
                                    <div class="dd-tl__meta">Web · IP 192.168.4.21 · Office WiFi</div>
                                </div>
                            </div>
                            <div class="dd-tl__item">
                                <span class="dd-tl__dot is-muted"></span>
                                <div style="flex:1">
                                    <div class="dd-tl__title">Currently working <span>—</span></div>
                                    <div class="dd-tl__meta">Last activity 2 min ago</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Status breakdown -->
                    <div class="ad-card">
                        <div class="ad-card__title">Status breakdown</div>
                        <div class="ad-card__sub">May 2026</div>
                        <div class="sb-donut-wrap">
                            <div class="sb-donut">
                                <div class="sb-donut__c">
                                    <div class="sb-donut__n">22</div>
                                    <div class="sb-donut__l">Work days</div>
                                </div>
                            </div>
                            <div class="sb-legend">
                                <span class="sb-leg"><i style="background:#16a34a"></i> Present <b>17</b></span>
                                <span class="sb-leg"><i style="background:#f29a2e"></i> Late <b>2</b></span>
                                <span class="sb-leg"><i style="background:#f6b85a"></i> Paid leave <b>2</b></span>
                                <span class="sb-leg"><i style="background:#0a7e9b"></i> Unpaid <b>1</b></span>
                                <span class="sb-leg"><i style="background:#2f72c4"></i> Holiday <b>2</b></span>
                                <span class="sb-leg"><i style="background:#e5564b"></i> Absent <b>1</b></span>
                            </div>
                        </div>
                        <div class="sb-stats">
                            <div class="sb-stat"><div class="sb-stat__l">Punctuality</div><div class="sb-stat__v">88 <small>%</small></div></div>
                            <div class="sb-stat"><div class="sb-stat__l">Streak</div><div class="sb-stat__v">4 <small>days</small></div></div>
                            <div class="sb-stat"><div class="sb-stat__l">Avg work</div><div class="sb-stat__v">8.4 <small>h</small></div></div>
                            <div class="sb-stat"><div class="sb-stat__l">YTD attendance</div><div class="sb-stat__v">94.6 <small>%</small></div></div>
                        </div>
                    </div>

                    <!-- Leave balances -->
                    <div class="ad-card">
                        <div class="lb-head">
                            <div>
                                <div class="ad-card__title">Leave balances</div>
                                <div class="ad-card__sub">FY 2026 entitlements</div>
                            </div>
                            <button type="button" class="ad-link-btn">View ledger</button>
                        </div>
                        <div class="lb-row">
                            <div class="lb-row__top"><span>Annual</span><b>6 <small>/ 18 left</small></b></div>
                            <div class="lb-bar"><span style="width:33%"></span></div>
                        </div>
                        <div class="lb-row">
                            <div class="lb-row__top"><span>Casual</span><b>6 <small>/ 10 left</small></b></div>
                            <div class="lb-bar"><span style="width:60%"></span></div>
                        </div>
                        <div class="lb-row">
                            <div class="lb-row__top"><span>Sick</span><b>6 <small>/ 8 left</small></b></div>
                            <div class="lb-bar"><span style="width:75%"></span></div>
                        </div>
                        <div class="lb-row">
                            <div class="lb-row__top"><span>Unpaid</span><b>1 <small>taken</small></b></div>
                            <div class="lb-bar is-unpaid"><span style="width:20%"></span></div>
                        </div>
                        <div class="lb-row">
                            <div class="lb-row__top"><span>Compensatory</span><b>2.5 <small>/ 3 left</small></b></div>
                            <div class="lb-bar"><span style="width:83%"></span></div>
                        </div>
                    </div>

                    <!-- Recent activity -->
                    <div class="ad-card">
                        <div class="ra-head">
                            <div>
                                <div class="ad-card__title">Recent activity</div>
                                <div class="ad-card__sub">Punches, leaves and regularizations</div>
                            </div>
                            <button type="button" class="ad-link-btn">View all</button>
                        </div>
                        <div class="ra-item">
                            <span class="ra-ic ra-c-green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg></span>
                            <div class="ra-body"><div class="ra-title">Clocked in</div><div class="ra-meta">06 May · 09:01 · Today · Office WiFi</div></div>
                            <span class="ra-time">2 min ago</span>
                        </div>
                        <div class="ra-item">
                            <span class="ra-ic ra-c-teal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5"/></svg></span>
                            <div class="ra-body"><div class="ra-title">Regularized 04 May late arrival</div><div class="ra-meta">Doctor's appointment — receipt attached · approved by Hira K.</div></div>
                            <span class="ra-time">Yesterday</span>
                        </div>
                        <div class="ra-item">
                            <span class="ra-ic ra-c-orange"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg></span>
                            <div class="ra-body"><div class="ra-title">Clocked out</div><div class="ra-meta">05 May · 19:42 · +1.7h overtime logged</div></div>
                            <span class="ra-time">1d</span>
                        </div>
                        <div class="ra-item">
                            <span class="ra-ic ra-c-blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/></svg></span>
                            <div class="ra-body"><div class="ra-title">Annual leave 07–08 May</div><div class="ra-meta">2 days · Paid · approved</div></div>
                            <span class="ra-time">3d</span>
                        </div>
                        <div class="ra-item">
                            <span class="ra-ic ra-c-orange"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
                            <div class="ra-body"><div class="ra-title">Late arrival flagged</div><div class="ra-meta">04 May · 10:38 (96 min late) · Auto-flag · pending review</div></div>
                            <span class="ra-time">3d</span>
                        </div>
                        <div class="ra-item">
                            <span class="ra-ic ra-c-green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg></span>
                            <div class="ra-body"><div class="ra-title">Clocked in</div><div class="ra-meta">01 May · Holiday — auto-skipped · Labour Day</div></div>
                            <span class="ra-time">5d</span>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
